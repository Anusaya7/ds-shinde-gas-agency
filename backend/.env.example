# ==============================================================================
# DS SHINDE GAS AGENCY — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# This template defines all backend environment variables required by the Express API,
# Prisma ORM, JWT Authentication, Payment Gateway, SMS & Email, and Document Encryption.
#
# IMPORTANT:
# - Copy this file to `.env` in the backend folder for local development.
# - For production deployments (Vercel, Railway, etc.), configure these keys in
#   your hosting provider's project settings dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE RUNTIME & APPLICATION SERVER
# ------------------------------------------------------------------------------
# NODE_ENV: 'development' | 'production' | 'test'
# Production mode activates strict secret validation and enables Secure cookie attributes.
NODE_ENV=production

# PORT: Local backend listening port (default: 5000)
PORT=5000

# FRONTEND_URL: Allowed origin for CORS and web links.
# Development: http://localhost:3000 (or http://localhost:5173)
# Production:  https://dsshinde-gas.vercel.app
FRONTEND_URL=https://dsshinde-gas.vercel.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection URI.
# Production requires a resilient PostgreSQL instance (e.g. Supabase, Neon, AWS RDS, Railway).
# Note: For serverless pooling with Supabase or Neon, append ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://db_user:StrongPassword123@db.supabase.co:5432/dsshinde_gas?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
# [CRITICAL SECURITY REQUIREMENT]
# - In production, JWT_SECRET and JWT_REFRESH_SECRET MUST each be >= 32 characters
#   and MUST NOT be equal to each other.
# - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long-min-entropy
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. DOCUMENT ENCRYPTION (AES-256-GCM FOR KYC PROOFS)
# ------------------------------------------------------------------------------
# [CRITICAL SECURITY REQUIREMENT]
# Encrypts customer Aadhaar proofs, Udyam certificates, and rider vehicle documents.
# - MUST be exactly 64 hexadecimal characters (32-byte key).
# - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Back up this key securely. Losing it means stored documents cannot be read.
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY INTEGRATION (RAZORPAY)
# ------------------------------------------------------------------------------
# API credentials obtained from Razorpay Dashboard (https://dashboard.razorpay.com).
# Test keys begin with "rzp_test_"; Live production keys begin with "rzp_live_".

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Secret configured under Razorpay Dashboard > Settings > Webhooks
# Target URL: https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL NOTIFICATIONS (NODEMAILER / SMTP)
# ------------------------------------------------------------------------------
# In development, if SMTP_USER is empty, emails are logged to the console.
# In production, use valid SMTP credentials (Gmail App Password, SendGrid, Amazon SES, Resend).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@dsshinde.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="DS Shinde Gas Agency <noreply@dsshindegas.com>"

# Resend HTTP API (used by the live email sender)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=DS Shinde Gas Agency <noreply@dsshindegas.com>

# ------------------------------------------------------------------------------
# 7. SMS SERVICE & OTP VERIFICATION
# ------------------------------------------------------------------------------
# SMS_PROVIDER: 'mock' (dev console) or 'msg91' (live transactional SMS)
SMS_PROVIDER=msg91

# DLT-registered 6-character header / Sender ID
SMS_SENDER_ID=DSSGAS

# Optional generic SMS key
SMS_API_KEY=

# MSG91 Flow Auth Key & Template ID (https://control.msg91.com)
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MSG91_OTP_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# OTP Developer mode: set to 'false' in production. If 'true', OTPs log to console in dev mode.
OTP_DEV_MODE=false
OTP_EXPIRY_MINUTES=10

# ------------------------------------------------------------------------------
# 8. SCHEDULED CRON JOBS & REMINDERS (VERCEL CRON)
# ------------------------------------------------------------------------------
# Protects the daily cylinder reminder dispatch: GET /api/reminders/process
# Verified against incoming header `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=replace-with-a-random-secure-cron-authorization-secret

# ------------------------------------------------------------------------------
# 9. RATE LIMITING & SECURITY LIMITS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# 10. OPTIONAL ADMINISTRATOR SEEDING & BOOTSTRAP
# ------------------------------------------------------------------------------
# Configures the default admin during `npm run prisma:seed` or auto-creation.
SEED_ADMIN_EMAIL=admin@dsshinde.com
SEED_ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword#2026
SEED_ADMIN_PHONE=9511760208
SEED_ADMIN_NAME="DS Shinde Agency Administrator"

# ------------------------------------------------------------------------------
# 11. GOOGLE MAPS INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional server-side geocoding or address resolution API key:
GOOGLE_MAPS_API_KEY=
