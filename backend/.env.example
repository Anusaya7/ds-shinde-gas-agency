# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ds_shinde_gas?schema=public"

# Authentication & JWT
JWT_SECRET=super-secret-jwt-key-ds-shinde-gas-agency-change-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-ds-shinde-gas-agency-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="D.S. Shinde Gas Agency <noreply@dsshinde.com>"

# SMS Gateway Configuration
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=DSSGAS

# OTP Configuration
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
