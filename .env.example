# ==============================================================================
# DS SHINDE GAS AGENCY — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# This template defines all environment variables required by the DS Shinde Gas
# Agency platform (Backend API, Prisma ORM, Authentication, Payments, Notifications,
# Document Encryption, Cron Jobs, and Frontend Client).
#
# IMPORTANT SECURITY GUIDELINES:
# 1. NEVER commit your actual `.env` file to version control.
# 2. In Production (e.g. Vercel / Railway / AWS), set these variables directly
#    inside your platform's Environment Variables dashboard.
# 3. All secrets marked [CRITICAL] must be generated with high-entropy cryptographically
#    secure random generators before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE RUNTIME & APPLICATION SERVER
# ------------------------------------------------------------------------------
# NODE_ENV: Runtime environment. Options: 'development' | 'production' | 'test'
# - In 'production', backend enforces strict secret checks (JWT >= 32 chars,
#   distinct keys, valid DOCUMENT_ENCRYPTION_KEY) and sets Secure cookie flags.
NODE_ENV=production

# PORT: Local HTTP server listening port. (Ignored in serverless environments like Vercel).
# - Development default: 5000
PORT=5000

# FRONTEND_URL: Public URL of the frontend application.
# Used for CORS whitelist validation and notification links.
# - Development: http://localhost:3000 (or http://localhost:5173)
# - Production:  https://dsshinde-gas.vercel.app (or custom domain https://dsshinde.com)
FRONTEND_URL=https://dsshinde-gas.vercel.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string required by Prisma.
# - Production: Managed PostgreSQL instance (Supabase, Neon, AWS RDS, Railway).
#   Ensure SSL mode is enabled (?sslmode=require) and connection pooling parameters
#   (e.g., ?pgbouncer=true or ?connection_limit=10) are included for serverless execution.
# - Development (SQLite fallback option): "file:./dev.db"
DATABASE_URL="postgresql://db_user:StrongPassword123@db.supabase.co:5432/dsshinde_gas?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
# [CRITICAL SECURITY REQUIREMENT]
# - In production, JWT_SECRET and JWT_REFRESH_SECRET MUST each be at least 32
#   characters in length and MUST BE MUTUALLY DISTINCT. The server will throw a
#   fatal initialization error if they are identical or shorter than 32 chars.
# - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Access token signing secret (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long-min-entropy

# Refresh token signing secret (must differ completely from JWT_SECRET)
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Access token lifespan (e.g., '15m', '1h', '1d')
JWT_EXPIRES_IN=1d

# Refresh token lifespan (e.g., '7d', '30d')
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. DOCUMENT ENCRYPTION (AES-256-GCM FOR KYC & COMPLIANCE DATA)
# ------------------------------------------------------------------------------
# [CRITICAL SECURITY REQUIREMENT]
# Customer Aadhaar proof, Udyam registration certificates, and Rider vehicle RC /
# license documents are encrypted in-flight using AES-256-GCM before storage.
# - MUST be exactly 64 hexadecimal characters (representing a 32-byte binary key).
# - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - DO NOT LOSE THIS KEY! If lost or rotated without data re-encryption, existing
#   uploaded customer/rider documents cannot be decrypted or reviewed.
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY INTEGRATION (RAZORPAY)
# ------------------------------------------------------------------------------
# Razorpay handles digital cylinder bookings (UPI, Credit/Debit Cards, Net Banking).
# - Development: Use test keys (rzp_test_...)
# - Production:  Use live keys (rzp_live_...) from the Razorpay Merchant Dashboard.
# Note: The backend refuses placeholder values in production orders.

# Razorpay API Key ID (public / publishable identifier)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Razorpay API Key Secret (strictly private)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret: Configured in Razorpay Dashboard > Settings > Webhooks
# pointing to: https://<your-domain>/api/payments/webhook
# Used to verify HMAC SHA-256 signatures on incoming payment status events.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL NOTIFICATIONS (NODEMAILER / SMTP)
# ------------------------------------------------------------------------------
# Sends order status confirmations, invoice notifications, and email OTPs.
# - For Gmail: Enable 2-Step Verification and create an "App Password".
# - For Dedicated Providers: Amazon SES, SendGrid, Resend, Mailgun, Brevo.
# - If SMTP_USER is blank in development, emails are safely logged to console.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@dsshinde.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="DS Shinde Gas Agency <contact@dsshinde.com>"

# ------------------------------------------------------------------------------
# 7. SMS SERVICE & OTP VERIFICATION
# ------------------------------------------------------------------------------
# SMS_PROVIDER: 'mock' | 'msg91'
# - 'mock': In development, OTP codes and messages are logged to the backend console.
# - 'msg91': Transactional SMS delivery via MSG91 Flow API (https://control.msg91.com).
SMS_PROVIDER=msg91

# SMS Sender ID / DLT Header (6 characters, registered with Indian telecom DLT)
SMS_SENDER_ID=DSSGAS

# Optional generic SMS API key (if using an alternate provider)
SMS_API_KEY=

# MSG91 Flow Auth Key (found in MSG91 dashboard under Settings > Auth Keys)
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MSG91 DLT-approved OTP template ID
# The template in MSG91 should accept the OTP variable, e.g., {#var#} or {#OTP#}
MSG91_OTP_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# OTP Developer Mode:
# When 'true' AND NODE_ENV='development', OTPs are printed to terminal console.
# MUST be set to 'false' in production.
OTP_DEV_MODE=false

# OTP validity window in minutes before expiration (default: 10 minutes)
OTP_EXPIRY_MINUTES=10

# ------------------------------------------------------------------------------
# 8. SCHEDULED CRON JOBS & REMINDERS (VERCEL CRON)
# ------------------------------------------------------------------------------
# CRON_SECRET: Secret Bearer token protecting the scheduled background route:
# GET /api/reminders/process (triggered daily at 09:00 UTC via vercel.json).
# - Vercel automatically attaches this secret as `Authorization: Bearer <CRON_SECRET>`
#   when invoking cron endpoints.
# - Generate using: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace-with-a-random-secure-cron-authorization-secret

# ------------------------------------------------------------------------------
# 9. RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
# Protects against brute force logins, OTP spamming, and API denial-of-service.
# Values can be increased during local automated testing if required.

# Rate limit time window in milliseconds (900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum general API requests allowed per IP within the window
RATE_LIMIT_MAX=100

# Maximum authentication requests (login/register) allowed per IP within 15 minutes
AUTH_RATE_LIMIT_MAX=10

# Maximum OTP send requests allowed per IP within 10 minutes
OTP_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# 10. OPTIONAL ADMINISTRATOR SEEDING & BOOTSTRAP
# ------------------------------------------------------------------------------
# Used by `npm run prisma:seed` and fallback admin bootstrap on first boot.
# If omitted, default fallbacks are used, but setting unique production admin
# credentials here guarantees strong initial account security.

SEED_ADMIN_EMAIL=admin@dsshinde.com
SEED_ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword#2026
SEED_ADMIN_PHONE=9511760208
SEED_ADMIN_NAME="DS Shinde Agency Administrator"

# ------------------------------------------------------------------------------
# 11. GOOGLE MAPS INTEGRATION (OPTIONAL ENHANCEMENTS)
# ------------------------------------------------------------------------------
# The platform currently uses native Google Maps deep-links and embed URLs
# (https://www.google.com/maps?q={lat},{lng}) which require no API key.
# If integrating Google Maps JavaScript SDK, Places Autocomplete, or Geocoding API:
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 12. FRONTEND CLIENT ENVIRONMENT (VITE — BUNDLED IN DIST)
# ------------------------------------------------------------------------------
# Note: Variables prefixed with VITE_ are embedded into public client-side JavaScript.
# NEVER put private API secrets, database passwords, or JWT keys into VITE_ variables!

# API backend endpoint for frontend Axios client:
# - Local Dev (with Vite reverse proxy configured in vite.config.ts): /api
# - Production with decoupled domains: https://api.dsshinde.com/api (or /api if unified on Vercel)
VITE_API_BASE_URL=/api

# Razorpay Publishable Key ID for client-side checkout popup (safe for public exposure)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 13. CLOUD PLATFORM / SERVERLESS ENVIRONMENT FLAGS (INFORMATIONAL)
# ------------------------------------------------------------------------------
# These variables are automatically injected by Vercel or AWS Lambda environments.
# You DO NOT need to set these manually, but the backend server detects them to
# prevent binding to local HTTP ports during serverless execution:
# - VERCEL=1
# - AWS_LAMBDA_FUNCTION_NAME=...
# - LAMBDA_TASK_ROOT=...
