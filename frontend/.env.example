# ==============================================================================
# DS SHINDE GAS AGENCY — FRONTEND CLIENT ENVIRONMENT (.env.example)
# ==============================================================================
# This file contains the client-side configuration for Vite + React.
#
# IMPORTANT:
# - Variables prefixed with `VITE_` are publicly accessible in the compiled bundle.
# - DO NOT place private API keys, JWT secrets, or DB credentials here!
# ==============================================================================

# API Base URL for backend communications
# - Development: '/api' (proxied by Vite to http://localhost:5000 in vite.config.ts)
# - Production: '/api' (when hosted together on Vercel) OR full API URL if separated
VITE_API_BASE_URL=/api

# Razorpay Key ID for client checkout modal (Safe to be public)
# - Development: rzp_test_xxxxxxxxxxxxxx
# - Production:  rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Optional Google Maps JavaScript / Places API Key (if map autocomplete is enabled)
VITE_GOOGLE_MAPS_API_KEY=
